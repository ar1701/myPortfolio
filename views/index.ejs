<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayush Raj - Portfolio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="#">Ayush Raj</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#home">Homeeee</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#experience">Experience</a></li>
                    <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="#skills">Skills</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero-section">
        <div class="container h-100">
            <div class="row h-100 align-items-center">
                <div class="col-12 text-center hero-content">
                    <h1 class="display-4 hero-title mb-4">Welcome to My Portfolio</h1>
                    <p class="lead mb-4">Computer Science Student | Developer | Tech Enthusiast</p>
                    <div class="contact-info">
                        <a href="mailto:<%= data.contact.email %>"><i class="fas fa-envelope"></i> <%= data.contact.email %></a>
                        <a href="<%= data.contact.github %>" target="_blank"><i class="fab fa-github"></i> GitHub</a>
                        <a href="<%= data.contact.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i> LinkedIn</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-5">
        <div class="container">
            <h2 class="section-title text-center">About Me</h2>
            <div class="row">
                <div class="col-lg-8 mx-auto">
                    <div class="card">
                        <div class="card-body">
                            <p class="lead">I am <%= data.name %>, a passionate computer science student currently pursuing my B.Tech degree at <%= data.education.institution %>. With a strong academic record of <%= data.education.cgpa %> CGPA, I am dedicated to exploring and learning new technologies.</p>
                            <div class="mt-4">
                                <h5>Education</h5>
                                <p><strong><%= data.education.degree %></strong><br>
                                <%= data.education.institution %><br>
                                <%= data.education.duration %><br>
                                CGPA: <%= data.education.cgpa %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="py-5 bg-light">
        <div class="container">
            <h2 class="section-title text-center">Experience</h2>
            <div class="row">
                <div class="col-lg-10 mx-auto">
                    <div class="experience-timeline">
                        <% data.experience.forEach(exp => { %>
                            <div class="timeline-item">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title"><%= exp.title %></h5>
                                        <h6 class="card-subtitle mb-2 text-muted"><%= exp.company %></h6>
                                        <p class="card-text text-muted"><%= exp.duration %></p>
                                        <ul class="list-unstyled">
                                            <% exp.points.forEach(point => { %>
                                                <li class="mb-2">• <%= point %></li>
                                            <% }); %>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-5">
        <div class="container">
            <h2 class="section-title text-center">Projects</h2>
            <div class="row">
                <% data.projects.forEach(project => { %>
                    <div class="col-lg-6 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title"><%= project.title %> <span class="text-muted">(<%= project.year %>)</span></h5>
                                <p class="card-text"><%= project.description %></p>
                                <p class="card-text"><small><%= project.details %></small></p>
                                <div class="technologies">
                                    <% project.technologies.forEach(tech => { %>
                                        <span class="badge bg-primary me-1 mb-1"><%= tech %></span>
                                    <% }); %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="py-5 bg-light">
        <div class="container">
            <h2 class="section-title text-center">Skills</h2>
            <div class="row">
                <div class="col-lg-10 mx-auto">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="mb-3">Programming Languages</h5>
                            <div class="skill-tags mb-4">
                                <% data.skills.languages.forEach(skill => { %>
                                    <span class="badge bg-primary me-2 mb-2"><%= skill %></span>
                                <% }); %>
                            </div>
                            <h5 class="mb-3">Technical Skills</h5>
                            <div class="skill-tags">
                                <% data.skills.technical.forEach(skill => { %>
                                    <span class="badge bg-secondary me-2 mb-2"><%= skill %></span>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Awards Section -->
    <section id="awards" class="py-5">
        <div class="container">
            <h2 class="section-title text-center">Awards & Achievements</h2>
            <div class="row">
                <div class="col-lg-10 mx-auto">
                    <div class="awards-list">
                        <% data.awards.forEach(award => { %>
                            <div class="award-item">
                                <h5><%= award.title %></h5>
                                <p class="text-muted"><%= award.date %></p>
                                <p><%= award.description %></p>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white text-center py-3">
        <p>&copy; 2024 <%= data.name %>. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/your-kit-code.js" crossorigin="anonymous"></script>
    <script src="/js/main.js"></script>
</body>
</html>